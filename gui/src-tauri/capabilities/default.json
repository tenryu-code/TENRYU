{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "TENRYU Studio main window: system ssh/scp execution, profile store, file dialogs",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:menu:default",
    "shell:default",
    "store:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "ssh", "cmd": "ssh", "args": true, "sidecar": false },
        { "name": "scp", "cmd": "scp", "args": true, "sidecar": false }
      ]
    }
  ]
}
